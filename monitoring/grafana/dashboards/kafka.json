{
 "uid": "mq-kafka",
 "title": "Kafka (single node)",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Brokers",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "kafka_brokers",
     "legendFormat": "brokers"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Topic messages in / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by(topic)(rate(kafka_topic_partition_current_offset[30s]))",
     "legendFormat": "{{topic}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Consumer group lag",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by(consumergroup,topic)(kafka_consumergroup_lag)",
     "legendFormat": "{{consumergroup}} {{topic}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Partitions per topic",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count by(topic)(kafka_topic_partition_current_offset)",
     "legendFormat": "{{topic}}"
    }
   ]
  }
 ],
 "tags": [
  "mq-study"
 ]
}